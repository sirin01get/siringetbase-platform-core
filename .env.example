# ---------------------------------------------------------------------------
# Siringetbase Platform Core — environment variables (Phase 0 scaffold)
# Copy to .env.local for local dev. Never commit real values — see
# ../security/README.md Tier 1: these are infrastructure secrets.
# ---------------------------------------------------------------------------
#
# ── The "# scope:" annotations are machine-read. Keep them accurate. ───────
#
# scripts/sync-secrets.mjs and scripts/verify-deployed-secrets.mjs derive
# their behaviour from these headings, and scripts/check-env-var-specs.mjs
# fails if a var read in src/config/env.ts isn't declared under one. Adding a
# var here with the right scope is the whole registration step.
#
#   build             NEXT_PUBLIC_*. Inlined by `next build` from .env.local on
#                     the build machine. NOT read from the Worker — setting
#                     these in Cloudflare does nothing.
#   runtime           Read from process.env inside the Worker at request time.
#                     MUST exist on the Worker. Pushed as a Worker Secret by
#                     `npm run secrets:sync`, and a deploy fails if one is
#                     missing. Stored as Secrets even when not sensitive (a
#                     base URL isn't) because Secrets are the only store that
#                     survives `wrangler deploy` — which reconciles config by
#                     FULL OVERWRITE and silently deletes plain Variables.
#   runtime, optional Same, but the code has a default. Synced when present,
#                     never demanded. A COMMENTED-OUT declaration counts as
#                     optional automatically.
#   tooling           wrangler/CI credentials for a developer machine. Never
#                     uploaded — putting deploy credentials inside the Worker
#                     they deploy widens their blast radius for no benefit.
#   binding           Configured in wrangler.jsonc (R2/D1/KV/AI), not an env
#                     var at all.
#
# This exists because runtime secrets on the verticals repeatedly reverted to
# "not set" days after being fixed — dashboard Variables wiped by the next
# deploy, while .env.local (a purely local file, never uploaded) made them
# look present. See scripts/sync-secrets.mjs for the full account.

# scope: build
# Supabase — Postgres system of record for identity + payments (siringetbase schema)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) — Supabase dashboard > Settings > API
# Keys > "Publishable and secret API keys" tab. If you only see anon/service_role
# keys, click "Create new API keys" first (safe — legacy keys keep working
# alongside the new ones until you deactivate them).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# scope: runtime
# Server-side only, never exposed to the client. Used by the entity-graph
# sync job and payments escrow primitives, which act across role_profiles
# that aren't necessarily the calling user's own.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# scope: runtime
# Neo4j — the Entity Graph (see ../entity-graph/README.md)
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# scope: runtime, optional
# Defaults to "neo4j" if unset, which is correct for most fresh AuraDB
# Free/Professional instances but not universal. If /api/diagnostics reports
# Neo.ClientError.Database.DatabaseNotFound, check Aura console → your
# instance → Connect (or run `SHOW DATABASES` in Neo4j Browser) for the real
# name and set it here.
# NEO4J_DATABASE=neo4j

# scope: tooling
# Cloudflare (deployment). Used by wrangler ON YOUR MACHINE / in CI — these
# are NOT uploaded to the Worker, deliberately. An API token that can deploy
# and read every Worker on the account has no business also being readable
# from inside one of them.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# scope: runtime, optional
# Payments — which mock adapter is active (see ../payments/README.md).
# Provider names, not secrets, and src/config/env.ts supplies defaults
# ("razorpay-mock"/"icici-mock") — so a deployment that never sets these is
# correct, not broken. Real gateway/bank API keys, once a real integration
# exists, would be separate required Worker Secrets, not these vars.
PAYMENT_GATEWAY_PROVIDER=razorpay-mock
BANK_PAYOUT_PROVIDER=icici-mock

# scope: runtime
# Comms — shared email pipeline (see ../comms/README.md).
# Resend dashboard → API Keys. Must be able to send from a domain you've
# verified in Resend (SPF/DKIM/DMARC) — see COMMS_FROM_ADDRESS below.
RESEND_API_KEY=re_your_resend_api_key
# Supabase dashboard → Authentication → Hooks → Send Email → after pointing
# it at this deployed app's /api/comms/auth-email-hook, Supabase shows this
# secret exactly once, in the exact "v1,whsec_..." form expected here.
SEND_EMAIL_HOOK_SECRET=v1,whsec_your_hook_secret

# scope: runtime, optional
# The From: address every comms email is sent as. The domain portion MUST
# be verified in Resend's dashboard (Domains → Add Domain → add the SPF/
# DKIM/DMARC records it gives you) or every send silently fails/bounces —
# see ../comms/README.md's Rollout Plan step 1. email.siringet.com is
# already Verified in Resend, so this is the real value, not a placeholder.
# Bare address only — the "CA Focus"/"LawForge"/etc. display name in front
# of it is no longer set here; it's resolved per-vertical at send time by
# src/lib/comms/from-name.ts.
COMMS_FROM_ADDRESS=onboarding@email.siringet.com

# scope: runtime
# Support Escalation — POST /api/comms/notify (see ../support-escalation/README.md).
# Any string works locally; in production, generate a long random value and
# set the IDENTICAL value here and on every calling vertical's deployment
# (e.g. cafocus/app's COMMS_INTERNAL_SECRET) as a Worker Secret — this is a
# shared-secret header check, not a signed webhook like the Send Email Hook.
COMMS_INTERNAL_SECRET=a-long-random-shared-secret

# scope: runtime, optional
# Where support.error_report_filed notifications land. Defaults to
# support@email.siringet.com (same verified domain as COMMS_FROM_ADDRESS).
# SUPPORT_INBOX_EMAIL=support@email.siringet.com

# scope: runtime
# Document Intelligence — POST /api/document-intelligence/extract (see
# ../document-intelligence/README.md). Same shared-secret-header pattern as
# COMMS_INTERNAL_SECRET above, just a separate secret — generate a long
# random value and set the IDENTICAL value here and on every calling
# vertical's deployment (e.g. cafocus/app's DOCUMENT_INTELLIGENCE_INTERNAL_SECRET)
# as a Worker Secret.
DOCUMENT_INTELLIGENCE_INTERNAL_SECRET=a-long-random-shared-secret
# No API key needed for the model call itself — it uses this Worker's own
# Workers AI binding (wrangler.jsonc's "ai" block), billed to whichever
# Cloudflare account owns this deployment. One-time activation step before
# the model will respond: see README.md's "Document Intelligence" section.

# scope: runtime
# Payments — POST /api/payments/hold and .../release (see ../payments/README.md).
# Same shared-secret-header pattern as the two secrets above, just a
# separate secret — generate a long random value and set the IDENTICAL
# value here and on every calling vertical's deployment (e.g. cafocus/app's
# PAYMENTS_INTERNAL_SECRET) as a Worker Secret.
PAYMENTS_INTERNAL_SECRET=a-long-random-shared-secret

# scope: runtime
# Recurring module-subscription billing — worker.ts's daily cron pings
# cafocus/app's own internal endpoint (see src/config/env.ts's
# cafocusAppBaseUrl()/subscriptionsInternalSecret() header comment for why
# the work has to happen over there rather than here). CAFOCUS_APP_BASE_URL
# is that app's deployed URL; SUBSCRIPTIONS_INTERNAL_SECRET MUST match
# cafocus/app's own SUBSCRIPTIONS_INTERNAL_SECRET exactly.
#
# This was the FIRST reverse-direction (platform-core → vertical) call in
# this build; LawForge's deadline sweep below is the second, so this is now
# a small family rather than a one-off.
CAFOCUS_APP_BASE_URL=https://cafocus-app.example.workers.dev
SUBSCRIPTIONS_INTERNAL_SECRET=a-long-random-shared-secret

# scope: runtime
# LawForge matter deadline reminders — the same daily 05:00 cron also pings
# lawforge/app's POST /api/internal/deadline-sweep. Unlike the cafocus call
# above (which is reverse-direction for an architectural reason), this one
# exists purely because of a plan limit: the Workers Free plan caps Cron
# Triggers at 5 ACCOUNT-wide, cafocus/app (2) + this Worker (3) use all
# five, and LawForge's own trigger was rejected at deploy with error 10072.
# LAWFORGE_APP_BASE_URL is that app's deployed URL;
# DEADLINE_REMINDERS_INTERNAL_SECRET MUST match lawforge/app's own value
# exactly. Without both set, LawForge lawyers silently stop receiving
# deadline reminders — nothing else breaks, which is exactly why the
# env-check dashboard lists them.
LAWFORGE_APP_BASE_URL=https://lawforge-app.example.workers.dev
DEADLINE_REMINDERS_INTERNAL_SECRET=a-long-random-shared-secret

# scope: runtime
# Env-check precheck dashboard — GET /api/internal/env-check (see
# src/lib/admin/env-check.ts). Same shared-secret-header pattern as every
# other internal secret above — generate a long random value and set the
# IDENTICAL value here and on cafocus/app's own ENV_CHECK_INTERNAL_SECRET.
# Lets cafocus/app's /admin/env-check combined dashboard read this
# deployment's own env-check report cross-Worker.
ENV_CHECK_INTERNAL_SECRET=a-long-random-shared-secret

# scope: runtime, optional
# GST-GSP provider name (see ../gst-gsp/README.md) — not a secret, and
# src/config/env.ts defaults it to "generic-gsp-mock". A real GSP's OAuth
# client credentials, once one is selected, would be separate REQUIRED Worker
# Secrets, not this var.
GST_GATEWAY_PROVIDER=generic-gsp-mock

# scope: runtime
# GST-GSP cross-Worker entry points — POST /api/gst-gsp/connect,
# .../push-return, .../status. Same shared-secret-header pattern as the other
# internal secrets above — generate a long random value and set the IDENTICAL
# value here and on every calling vertical's deployment (e.g. cafocus/app's
# GST_GSP_INTERNAL_SECRET) as a Worker Secret.
GST_GSP_INTERNAL_SECRET=a-long-random-shared-secret

# scope: runtime, optional
# Document Intelligence Phase 4 fallback providers (see
# ../document-intelligence/PERFORMANCE_STRATEGY.md item 10 and
# src/lib/document-intelligence/model-gateway.ts). Both optional — Workers
# AI stays the default provider either way; these are only ever called if a
# Workers AI extraction call fails or times out. Leave blank to keep
# today's "Workers AI failure = hard failure" behavior.
# platform.openai.com/api-keys — needs access to a vision-capable chat
# model (gpt-4o-mini or gpt-4o).
# OPENAI_API_KEY=sk-your-openai-api-key
# aistudio.google.com/apikey — needs access to a vision-capable Gemini
# model (gemini-1.5-flash or gemini-1.5-pro). Tried after OpenAI in the
# fallback chain (or in OpenAI's place if only this one is set).
# GEMINI_API_KEY=your-gemini-api-key
